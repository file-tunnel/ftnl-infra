.DS_Store
rendered/
*.tmp
.cache/
.direnv/

# Local environment material. Ciphertext under env/enc is deliberately
# versioned; decrypted env/dec files and root-level dotenv links never are.
.env
.env.*
!.env.example
*.env
**/*.env
*.env.*
!.env.example
env/dec/
env/dec/**
env/*.env
**/.env**
!.env.example
!env/enc/
!env/enc/*.env.enc

# Supabase CLI local linkage/cache material. The project ref belongs in the
# encrypted production bundle, not in generated working-directory state.
supabase/.temp/

# Local credentials and kube contexts.
*.pem
*.p8
*.p12
*.jks
*.keystore
kubeconfig
*.kubeconfig

tmp/worktrees
temp/worktrees

# ores-sops dotenv hardening: plaintext dotenv is local-only at every depth;
# only env/enc/*.env.enc (sops ciphertext) is tracked. See env/README.md.
**/**/*.env
env/dec

# Sanctioned scratch locations - AGENTS.md requires both, trailing-slash form
tmp/
temp/

# machine-local symlink to ORESoftware/my-ai AGENTS.md; never committed
.ores/
